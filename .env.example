# InsForge: Dashboard > Install > API Keys (o `npx -y @insforge/cli secrets get ANON_KEY`)
NEXT_PUBLIC_INSFORGE_URL=https://tu-app.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=
# API key del proyecto. Solo servidor: NUNCA con prefijo NEXT_PUBLIC_.
INSFORGE_API_KEY=

# Opcionales: texto del campo de búsqueda en la página pública y nombre del evento.
NEXT_PUBLIC_ETIQUETA_BUSQUEDA=Nombre completo
NEXT_PUBLIC_NOMBRE_EVENTO=
