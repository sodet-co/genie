# Supabase: Project Settings → API Keys (URL en Project Settings → Data API).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave pública (publishable / anon): solo para el login del panel.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta (secret / service_role). Solo servidor: NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional, solo para migraciones y scripts locales (no va en Vercel):
# Connect → Session pooler → URI, con la contraseña de la base.
SUPABASE_DB_URL=
